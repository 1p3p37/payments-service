DB_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBIT_URL=amqp://guest:guest@rabbitmq:5672/
# значение из примеров README; в любом окружении кроме локального — заменить
API_KEY=dev-api-key
# Swagger /docs и /openapi.json открыты без ключа, запросы из них — с ключом (Authorize);
# false — выключить документацию (например, в проде)
API_DOCS_ENABLED=true

# 3 retry с задержками 1/2/4 с, затем DLQ
MAX_RETRIES=3
RETRY_BASE_DELAY=1

GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5

WEBHOOK_TIMEOUT=5

OUTBOX_BATCH_SIZE=1000
OUTBOX_PUBLISH_CONCURRENCY=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_SHUTDOWN_TIMEOUT=30
